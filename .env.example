# Application Environment
ENVIRONMENT=development
PORT=8000

# MongoDB Database Configuration (Leave empty to use built-in In-Memory Mock Store)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cit_scheduling

# Authentication & JWT Security
JWT_SECRET=super_secret_cit_scheduling_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Google Gemini AI Gateway (Optional: structured fallback regex parser activates automatically if missing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OR-Tools CP-SAT Solver Configuration
SOLVER_TIME_LIMIT_SEC=40
SOLVER_NUM_WORKERS=2

# Rescheduling Disruption Tuning
RESCHEDULE_MAX_TIERS=4
RESCHEDULE_NEIGHBORHOOD_WINDOW_DAYS=1
